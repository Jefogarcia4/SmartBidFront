VITE_API_URL=http://localhost:5080

# --- Office 365 / Microsoft Entra ID (App Registration) ---
# Mismos valores que AzureAd:ClientId / AzureAd:TenantId en el appsettings.json del API.
VITE_AAD_CLIENT_ID=e3f47c8a-8201-4c0e-a338-050b80dff851
VITE_AAD_TENANT_ID=b5db06c4-f419-452c-97de-8e2f49c61136
# Opcional: scope del API expuesto en Azure (ej. api://<CLIENT_ID>/access_as_user).
# Sin definir, se envía el idToken, que el API también acepta.
VITE_AAD_API_SCOPE=<API_SCOPE>
