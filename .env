VITE_API_URL=http://localhost:5080

# --- Office 365 / Microsoft Entra ID (App Registration) ---
# Reemplaza los placeholders para habilitar el login con Microsoft.
VITE_AAD_CLIENT_ID=<CLIENT_ID>
VITE_AAD_TENANT_ID=<TENANT_ID>
# Opcional: scope del API expuesto en Azure (ej. api://<CLIENT_ID>/access_as_user)
VITE_AAD_API_SCOPE=<API_SCOPE>
